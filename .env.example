# Copy to .env and fill in: cp .env.example .env
# Never commit .env — it may hold the Cloudflare tunnel token.
PORT=8080
TOGETHER_DATA_DIR=/data
TOGETHER_MAX_ROOMS=64
TOGETHER_TLS_MODE=off
# Operator-created in the Cloudflare dashboard (Zero Trust -> Tunnels).
# Only needed for `docker compose --profile tunnel up -d`.
TUNNEL_TOKEN=
