# web/_headers — Cloudflare Pages header rules for the Together web build.
# Pages/CDN serves precompressed .br/.gz sidecars automatically when the
# client advertises them via Accept-Encoding, so no extra rule is needed
# for the compressed bundle files the Godot web export produces.

/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Cache-Control: public, max-age=31536000, immutable

/*.pck
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
