;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Together"
run/main_scene="res://server/serve.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Config="*res://autoload/Config.gd"
